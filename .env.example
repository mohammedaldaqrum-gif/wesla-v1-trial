# WESLA Trial - Production Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Security
SESSION_SECRET=<generate-a-random-64-char-string-here>

# Database (SQLite - path is relative to project root)
# DATABASE_PATH=wesla_v4_8.db

# Trial Mode Settings
TRIAL_MODE=true
TRIAL_EXPIRY_DAYS=30

# Optional: Email alerts (configure if needed)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# ALERT_EMAIL=

# Optional: External URL for notifications
# PUBLIC_URL=https://trial.yourdomain.com
